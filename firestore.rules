rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function teacher() { return request.auth != null && request.auth.uid == 'V4xlfqFmlgNGAISKJE28xx66u883'; }
  function song(s) {
   return s is map && s.keys().hasAll(['title','artist'])
    && s.title is string && s.title.size() >= 1 && s.title.size() <= 100
    && s.artist is string && s.artist.size() >= 1 && s.artist.size() <= 100
    && (!('url' in s) || (s.url is string && s.url.matches('https://(open[.]spotify[.]com/track/[A-Za-z0-9]{22}|www[.]youtube[.]com/watch[?]v=[A-Za-z0-9_-]{11}|youtu[.]be/[A-Za-z0-9_-]{11})')))
    && (!('youtubeUrl' in s) || (s.youtubeUrl is string && s.youtubeUrl.matches('https://(www[.]youtube[.]com/watch[?]v=[A-Za-z0-9_-]{11}|youtu[.]be/[A-Za-z0-9_-]{11})')))
    && (!('spotifyUrl' in s) || (s.spotifyUrl is string && s.spotifyUrl.matches('https://open[.]spotify[.]com/track/[A-Za-z0-9]{22}')))
    && ('url' in s || 'youtubeUrl' in s || 'spotifyUrl' in s);
  }
  match /playlist/{id} {
   allow get: if true;
   allow list: if request.query.limit <= 30;
   allow create, update: if teacher() && song(request.resource.data)
    && request.resource.data.keys().hasOnly(['title','artist','url','youtubeUrl','spotifyUrl','genre','coverUrl'])
    && (!('coverUrl' in request.resource.data) || (request.resource.data.coverUrl is string && request.resource.data.coverUrl.size() <= 1000 && (request.resource.data.coverUrl == '' || request.resource.data.coverUrl.matches('https://[^ ]+'))))
    && request.resource.data.genre in ['Pop','Cozy','K-Pop','Classics','Piano'];
   allow delete: if teacher();
  }
  match /songOverrides/{id} {
   allow get: if true;
   allow list: if request.query.limit <= 30;
   allow create, update: if teacher() && id.matches('s([1-9]|[12][0-9]|30)') && song(request.resource.data)
    && request.resource.data.keys().hasOnly(['title','artist','url','youtubeUrl','spotifyUrl','genre','coverUrl'])
    && (!('coverUrl' in request.resource.data) || (request.resource.data.coverUrl is string && request.resource.data.coverUrl.size() <= 1000 && (request.resource.data.coverUrl == '' || request.resource.data.coverUrl.matches('https://[^ ]+'))))
    && request.resource.data.genre in ['Pop','Cozy','K-Pop','Classics','Piano'];
   allow delete: if teacher();
  }
  match /snowmen/{id} {
   allow get: if teacher() || resource.data.status == 'approved';
   allow list: if (teacher() || resource.data.status == 'approved') && request.query.limit <= 20;
   allow create: if request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous'
    && request.resource.data.keys().hasAll(['name','hat','scarf','face','accessory','scene','creator','classroom','intro','uid','status','createdAt'])
    && request.resource.data.keys().hasOnly(['name','hat','scarf','face','accessory','scene','creator','classroom','intro','uid','status','createdAt'])
    && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time
    && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 22
    && request.resource.data.creator is string && request.resource.data.creator.size() >= 1 && request.resource.data.creator.size() <= 30
    && request.resource.data.classroom is string && request.resource.data.classroom.size() >= 1 && request.resource.data.classroom.size() <= 20
    && request.resource.data.intro is string && request.resource.data.intro.size() >= 1 && request.resource.data.intro.size() <= 160
    && request.resource.data.hat in ['santa','top','knit','none','crown','antlers','earmuffs','elf']
    && request.resource.data.scarf in ['#e994ae','#83c5af','#9faedf','#e8c47d','#d67b79','#b6a0d3','#e34e68','#248f77','#f29b54','#62b7df','#f4d35e','#e87dbb']
    && request.resource.data.face in ['happy','sleepy','wink','excited','glasses']
    && request.resource.data.accessory in ['star','gift','candy','none','bell','cookie','lantern','heart','tree','cocoa','wreath','music']
    && request.resource.data.scene in ['day','night','sunset','forest','festival','aurora'];
   allow update: if teacher() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status in ['pending','approved','rejected'];
   allow delete: if teacher();
  }
  match /playlistShares/{id} {
   allow get: if teacher() || resource.data.status == 'approved';
   allow list: if (teacher() || resource.data.status == 'approved') && request.query.limit <= 20;
   allow create: if request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous'
    && request.resource.data.keys().hasAll(['title','name','message','url','uid','status','createdAt'])
    && request.resource.data.keys().hasOnly(['title','name','message','url','uid','status','createdAt'])
    && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time
    && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 80
    && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 30
    && request.resource.data.message is string && request.resource.data.message.size() <= 160
    && request.resource.data.url is string && request.resource.data.url.size() <= 250
    && request.resource.data.url.matches('https://(open[.]spotify[.]com/playlist/[A-Za-z0-9]{22}|www[.]youtube[.]com/playlist[?]list=[A-Za-z0-9_-]{10,150})');
   allow update: if teacher() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status in ['pending','approved','rejected'];
   allow delete: if teacher();
  }
  match /wishes/{id} {
   allow get: if teacher() || resource.data.status == 'approved';
   allow list: if (teacher() || resource.data.status == 'approved') && request.query.limit <= 30;
   allow create: if request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous'
    && request.resource.data.keys().hasAll(['name','classroom','message','status','createdAt','uid'])
    && request.resource.data.keys().hasOnly(['name','classroom','message','status','createdAt','uid','recipient','songId','customSong'])
    && (!('customSong' in request.resource.data) || ( !('songId' in request.resource.data) && song(request.resource.data.customSong) && request.resource.data.customSong.keys().hasOnly(['title','artist','url','youtubeUrl','spotifyUrl'])))
    && (!('recipient' in request.resource.data) || (request.resource.data.recipient is string && request.resource.data.recipient.size() >= 1 && request.resource.data.recipient.size() <= 45))
    && (!('songId' in request.resource.data) || request.resource.data.songId in ['s1','s2','s3','s4','s5','s6','s7','s8','s9','s10','s11','s12','s13','s14','s15','s16','s17','s18','s19','s20','s21','s22','s23','s24','s25','s26','s27','s28','s29','s30'])
    && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending'
    && request.resource.data.createdAt == request.time
    && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 30
    && request.resource.data.classroom is string && request.resource.data.classroom.size() >= 1 && request.resource.data.classroom.size() <= 20
    && request.resource.data.message is string && request.resource.data.message.size() >= 8 && request.resource.data.message.size() <= 180;
   allow update: if teacher() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status in ['pending','approved','rejected'];
   allow delete: if teacher();
  }
  // v6.3 Game Festival — separate from existing student content.
  function gamePoints(s) {
   return s.quiz is int && s.quiz >= 0 && s.quiz <= 100 && s.quiz % 20 == 0
    && s.memory is int && s.memory >= 0 && s.memory <= 100 && s.memory % 5 == 0
    && s.catch is int && s.catch >= 0 && s.catch <= 100 && s.catch % 10 == 0
    && s.word is int && s.word >= 0 && s.word <= 100 && s.word % 20 == 0
    && s.xp is int && s.xp == s.quiz + s.memory + s.catch + s.word && s.xp > 0 && s.xp <= 400
    && s.nick is string && s.nick.size() >= 1 && s.nick.size() <= 24
    && s.classroom is string && s.classroom.size() >= 1 && s.classroom.size() <= 20;
  }
  function gameOpen(r) {
   let c = get(/databases/$(database)/documents/gameConfig/current).data;
   return c.enabled == true && c.round == r;
  }
  function gameStudent(u) {
   return request.auth != null && request.auth.uid == u && request.auth.token.firebase.sign_in_provider == 'anonymous';
  }
  function gameSubmission(s,r) {
   return s.keys().hasAll(['nick','classroom','quiz','memory','catch','word','xp','status','updatedAt'])
    && s.keys().hasOnly(['nick','classroom','quiz','memory','catch','word','xp','status','updatedAt'])
    && gamePoints(s) && s.status == 'pending' && s.updatedAt == request.time && gameOpen(r);
  }
  match /gameConfig/current {
   allow get: if true;
   allow create, update: if teacher() && request.resource.data.keys().hasAll(['round','enabled','games','questions'])
    && request.resource.data.keys().hasOnly(['round','enabled','games','questions'])
    && request.resource.data.round is string && request.resource.data.round.matches('[A-Za-z0-9_-]{1,30}')
    && request.resource.data.enabled is bool && request.resource.data.games is map
    && request.resource.data.games.keys().hasAll(['quiz','memory','catch','word'])
    && request.resource.data.games.keys().hasOnly(['quiz','memory','catch','word'])
    && request.resource.data.games.quiz is bool && request.resource.data.games.memory is bool
    && request.resource.data.games.catch is bool && request.resource.data.games.word is bool
    && request.resource.data.questions is list && request.resource.data.questions.size() == 5;
  }
  match /gameRounds/{round}/scores/{uid} {
   allow get: if teacher() || gameStudent(uid);
   allow list: if teacher() && request.query.limit <= 20;
   allow create: if gameStudent(uid) && gameSubmission(request.resource.data,round);
   allow update: if (teacher() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
    && request.resource.data.status in ['approved','rejected'])
    || (gameStudent(uid) && gameSubmission(request.resource.data,round)
    && request.time >= resource.data.updatedAt + duration.value(60,'s')
    && request.resource.data.xp > resource.data.xp
    && request.resource.data.quiz >= resource.data.quiz && request.resource.data.memory >= resource.data.memory
    && request.resource.data.catch >= resource.data.catch && request.resource.data.word >= resource.data.word);
  }
  match /gameRounds/{round}/board/{uid} {
   allow get: if true;
   allow list: if request.query.limit <= 30;
   allow create, update: if teacher()
    && request.resource.data.keys().hasAll(['nick','classroom','quiz','memory','catch','word','xp','approvedAt'])
    && request.resource.data.keys().hasOnly(['nick','classroom','quiz','memory','catch','word','xp','approvedAt'])
    && gamePoints(request.resource.data) && request.resource.data.approvedAt == request.time;
   allow delete: if teacher();
  }

 }
}
